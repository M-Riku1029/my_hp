{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Node Static Server",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.mjs"],
      "port": 8002
    },
    {
      "name": "Static Server (npx serve 8001)",
      "runtimeExecutable": "C:\\Program Files\\Git\\bin\\bash.exe",
      "runtimeArgs": ["-c", "npx serve -l 8001 ."],
      "port": 8001
    },
    {
      "name": "Static Server (PowerShell)",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-ExecutionPolicy", "Bypass", "-File", "serve.ps1"],
      "port": 3000
    },
    {
      "name": "Static Server (npx serve)",
      "runtimeExecutable": "C:\\Program Files\\Git\\usr\\bin\\perl.exe",
      "runtimeArgs": ["serve.pl"],
      "port": 8000
    },
    {
      "name": "Static Server (Python)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8080"],
      "port": 8080
    }
  ]
}
